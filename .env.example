# Gemini API key pool for this gateway only; keep project/account credentials separate.
GEMINI_API_KEYS=
# Bearer token for the HTTP transport (generate: openssl rand -hex 32)
GEMINI_MCP_TOKEN=
# Optional shared quota-ledger path; unset uses the configured default.
GEMINI_ROUTER_STATE=
# Optional explicit config paths
# GEMINI_MCP_CONFIG=
# GEMINI_ROUTER_CONFIG=
