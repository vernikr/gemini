# Gemini key pool (shared with external-consumer): comma-separated list, or GEMINI_API_KEY_1..10
GEMINI_API_KEYS=
# Bearer token for the HTTP transport (generate: openssl rand -hex 32)
GEMINI_MCP_TOKEN=
# Shared quota ledger for ALL consumers on this machine (router + mcp + external-consumer later)
GEMINI_ROUTER_STATE=/opt/apps/shared/gemini-router/state.db
# Optional: explicit config paths
# GEMINI_MCP_CONFIG=/opt/apps/gemini-mcp/config.yaml
# GEMINI_ROUTER_CONFIG=
